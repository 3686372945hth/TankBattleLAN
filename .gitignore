# 引擎核心缓存（打开项目会自动生成，无需上传）
Library/
Temp/
Obj/
Logs/
UserSettings/

# Burst 编译大文件缓存（大文件，不上传）
*_BurstDebugInformation_DoNotShip/

# codely 工具文件（非游戏项目内容）
.codely-packages/
.codely-cli/
.codelyignore
MirrorExamplesPipelineConverted.txt

# 打包输出文件
Build/
Builds/
*.apk
*.exe
*.aab

# IDE 配置文件
.vs/
.vscode/
*.csproj
*.sln
*.suo
*.user

# 系统临时文件
.DS_Store
Thumbs.db
